                  "type": "number",
                  "minimum": 0
                },
                "target": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "productId",
                "sellingMethod",
                "remaining"
              ],
              "additionalProperties": false
            },
            "maxItems": 300,
            "default": []
          },
          "unlistedStockIsEmpty": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "orderNumbers"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
