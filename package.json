{
  "name": "mcp-server-shufersal",
  "version": "0.0.1",
  "description": "MCP server for shufersal automation using Puppeteer",
  "license": "MIT",
  "author": "Mati Horowitz",
  "authorUrl": "https://github.com/matipojo",
  "type": "module",
  "bin": {
    "shufersal-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc && node scripts/make-executable.mjs",
    "watch": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && node --test tests/browser/*.test.mjs",
    "check": "npm run lint && npm test && npm run test:browser"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "puppeteer": "25.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@typescript/lib-dom": "npm:@types/web@^0.0.242",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24"
  }
}
